{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.argo.local/dt/deadletter-v1.schema.json",
  "title": "ARGO Digital Twin dead-letter replay marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "twin_id",
    "sequence",
    "stage",
    "reason",
    "delivery_count",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "argo.dt.deadletter/v1" },
    "twin_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "stage": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "reason": { "enum": ["INVALID_EVENT", "MAX_DELIVER_EXCEEDED"] },
    "delivery_count": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
