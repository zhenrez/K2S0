{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argo.local/schemas/lineage-trace-v1.schema.json",
  "title": "Epistemic lineage trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "twin_id",
    "root",
    "ancestors",
    "dependents",
    "evidence_groups"
  ],
  "properties": {
    "schema_version": { "const": "argo.dt.lineage-trace/v1" },
    "twin_id": { "type": "string", "minLength": 1 },
    "root": { "$ref": "#/$defs/node" },
    "ancestors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "dependents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "evidence_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["independence_group", "evidence_ids"],
        "properties": {
          "independence_group": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id"],
      "properties": {
        "kind": {
          "enum": [
            "evidence",
            "entity",
            "claim",
            "contradiction",
            "correction",
            "projection"
          ]
        },
        "node_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
